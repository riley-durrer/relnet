{
  "name": "relnet",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "compile": "aztec compile --workspace",
    "codegen": "aztec codegen target --outdir src/artifacts",
    "build": "npm run compile && npm run codegen",
    "test": "tsx src/test/negotiate.test.ts && tsx src/test/examples.test.ts && tsx src/test/release.test.ts && tsx src/test/cli.test.ts && tsx src/test/channel.test.ts && tsx src/test/e2e/agreement.e2e.ts && tsx src/test/e2e/escrow.e2e.ts && tsx src/test/e2e/performance_proof.e2e.ts && tsx src/test/e2e/hostile.e2e.ts && tsx src/test/e2e/release.e2e.ts",
    "demo": "LOG_LEVEL=silent tsx src/demo/main.ts",
    "ui": "LOG_LEVEL=silent tsx src/ui/server.ts",
    "funding": "tsx src/funding/main.ts",
    "test:funding": "tsx src/test/funding.test.ts",
    "sandbox": "aztec start --local-network",
    "example:report": "tsx src/examples/cli.ts report",
    "example:lint": "tsx src/examples/cli.ts lint",
    "example:prompt": "tsx src/examples/cli.ts prompt",
    "example:check": "tsx src/examples/cli.ts check",
    "example:results": "tsx src/examples/cli.ts results",
    "relnet": "tsx src/cli/relnet.ts",
    "verify": "tsx src/release/verify.ts",
    "package-release": "tsx src/release/package.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@aztec/accounts": "5.2.1",
    "@aztec/aztec.js": "5.2.1",
    "@aztec/constants": "5.2.1",
    "@aztec/noir-contracts.js": "5.2.1",
    "@aztec/protocol-contracts": "5.2.1",
    "@aztec/stdlib": "5.2.1",
    "@aztec/wallets": "5.2.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
